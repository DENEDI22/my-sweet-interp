var int counter = 0;
//things whatever...j lksjdfölsa
loop {
    match counter {
        < 10 {
            counter = counter + 1;
            print(counter);
        }
        < 150 {
            counter = counter + 1;
            continue
            //just a comment for fun...
            print(counter);
        }
        _ {
            break
        }
    }
}
print(counter);
